# Local Compose entrypoint
COMPOSE_PROJECT_NAME=enterprise-chat-platform
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
LOCAL_START_TIMEOUT_SECONDS=180

# Application
CHAT_ENVIRONMENT=local
CHAT_SERVICE_NAME=enterprise-chat-api
CHAT_LOG_LEVEL=INFO
CHAT_DEBUG=false

# Local authentication
# The local frontend uses a demo login backed by a generated HS256 key. The
# start helper fills CHAT_JWT_KEY without printing it. Staging and production
# must disable demo auth and use externally managed asymmetric JWT keys.
CHAT_AUTH_MODE=jwt
CHAT_ALLOW_INSECURE_DEVELOPMENT_AUTH=false
CHAT_DEMO_AUTH_ENABLED=true
CHAT_ACCESS_TOKEN_EXPIRE_MINUTES=480
CHAT_JWT_ALGORITHM=HS256
CHAT_JWT_KEY=
CHAT_JWT_ISSUER=enterprise-chat-platform
CHAT_JWT_AUDIENCE=enterprise-chat-api

# Realtime delivery
CHAT_REALTIME_ENABLED=true
CHAT_REDIS_URL=redis://redis:6379/0
CHAT_WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
CHAT_WEBSOCKET_MAX_MESSAGE_BYTES=32768
CHAT_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHAT_CONNECTION_LEASE_SECONDS=90
CHAT_PER_USER_MESSAGES_PER_MINUTE=10
CHAT_REALTIME_RELAY_POLL_INTERVAL_SECONDS=0.5
CHAT_REALTIME_RELAY_LEASE_SECONDS=30
CHAT_REALTIME_RELAY_INITIAL_BACKOFF_SECONDS=1
CHAT_REALTIME_RELAY_MAX_BACKOFF_SECONDS=30

# Worker reliability controls. The built-in Echo provider is deterministic and
# intended for local learning; replace it with Gemini or another adapter before
# production.
CHAT_PROVIDER_MODE=echo
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=gemini-2.5-flash
CHAT_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CHAT_WORKER_SERVICE_AUTHOR_ID=00000000-0000-4000-8000-000000000001
CHAT_WORKER_POLL_INTERVAL_SECONDS=0.5
CHAT_WORKER_LEASE_SECONDS=60
CHAT_PROVIDER_TIMEOUT_SECONDS=30
CHAT_WORKER_MAX_ATTEMPTS=5
CHAT_WORKER_INITIAL_BACKOFF_SECONDS=1
CHAT_WORKER_MAX_BACKOFF_SECONDS=60
CHAT_WORKER_JITTER_FRACTION=0.2

# Local PostgreSQL infrastructure. The start helper generates blank passwords
# as URL-safe hexadecimal values and never prints them.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=55432

POSTGRES_BOOTSTRAP_USER=enterprise_chat_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=

POSTGRES_APP_DATABASE=enterprise_chat
POSTGRES_APP_SCHEMA=chat

POSTGRES_MIGRATOR_USER=enterprise_chat_migrator
POSTGRES_MIGRATOR_PASSWORD=

POSTGRES_RUNTIME_USER=enterprise_chat_app
POSTGRES_RUNTIME_PASSWORD=

# Optional host-process overrides. Compose builds container URLs from the
# PostgreSQL values above and does not inject these blank values into services.
# Format: postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
CHAT_DATABASE_URL=
CHAT_MIGRATION_DATABASE_URL=
